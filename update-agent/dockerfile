FROM python:3.12-slim

# Install system utilities (util-linux contains nsenter, curl is useful for healthchecks)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    util-linux \
    && rm -rf /var/lib/apt/lists/*

# Install FastAPI and Uvicorn for the update runner API
RUN pip install --no-cache-dir fastapi uvicorn

WORKDIR /app

COPY update-check.py .

# Create data directory for shared volume output
RUN mkdir -p /data

ENV UPDATE_STATUS_FILE=/data/update-status.json
ENV TRIGGER_FILE=/data/trigger-refresh
ENV CHECK_INTERVAL_SECONDS=3600
ENV PORT=5000

EXPOSE 5000

CMD ["python3", "-u", "update-check.py"]
