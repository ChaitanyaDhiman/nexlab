# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# self-signed certificate
self-signed.crt
self-signed.key

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.vscode/settings.json
docker-services/filebrowser/filebrowser.db
**/postgres_data
**/redis_data
**/data
!docker-services/**/docker-compose.yml

# User's personal app configuration
config/apps.json
config/storage.json
config/widgets.json

# Keep example configuration in repo
!config/apps.example.json
!config/storage.example.json
!config/widgets.example.json
docs/SECURITY_AUDIT_AND_ROADMAP.md
